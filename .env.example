# Required for real OpenAI LLM/search calls
OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-nano
# Optional: use a different OpenAI model for the Researcher step. Defaults to OPENAI_MODEL.
OPENAI_SEARCH_MODEL=gpt-4.1-nano
# model = normal OpenAI LLM research call; web = hosted OpenAI web_search tool.
# Keep model for gpt-4.1-nano to avoid web-search tool rejection.
OPENAI_SEARCH_MODE=model

# Optional cost-estimation overrides, per 1M text tokens.
# GPT-4.1 nano defaults are built into the lab code; set these only if you use another model.
# OPENAI_INPUT_COST_PER_1M=
# OPENAI_OUTPUT_COST_PER_1M=
# Optional if you want to manually include a separate web-search tool-call fee in reports.
# OPENAI_WEB_SEARCH_COST_PER_CALL=

# Optional tracing providers
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional search provider
TAVILY_API_KEY=

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
